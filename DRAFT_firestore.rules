rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Phase 4.1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'katukojwalamaniharanchary@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function canEditResources() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canEditResources == true
      );
    }

    function isBoundedStringArray(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    // Validation Blueprints (Pillar 2)
    function isValidUser(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'role', 'canEditResources', 'examLightMode',
        'workspaceId', 'solvedCount', 'masteredCount', 'spokenCount',
        'roadmapDoneCount', 'streakDays', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'role', 'canEditResources', 'examLightMode',
        'workspaceId', 'solvedCount', 'masteredCount', 'spokenCount',
        'roadmapDoneCount', 'streakDays', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.role is string && data.role.size() <= 20 && (data.role == 'admin' || data.role == 'member') &&
      data.canEditResources is bool &&
      data.examLightMode is bool &&
      data.workspaceId is string && data.workspaceId.size() <= 32 && data.workspaceId == 'faang-hub' &&
      data.solvedCount is int && data.solvedCount >= 0 && data.solvedCount <= 10000 &&
      data.masteredCount is int && data.masteredCount >= 0 && data.masteredCount <= 10000 &&
      data.spokenCount is int && data.spokenCount >= 0 && data.spokenCount <= 10000 &&
      data.roadmapDoneCount is int && data.roadmapDoneCount >= 0 && data.roadmapDoneCount <= 1000 &&
      data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
      isValidId(data.uid) &&
      isValidId(data.grantedBy) &&
      data.createdAt is timestamp;
    }

    function isValidResourceItem(data) {
      return data.keys().hasAll([
        'id', 'title', 'category', 'typeFocus', 'priority',
        'recommendedUse', 'url', 'status', 'notes', 'visibility',
        'updatedBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'category', 'typeFocus', 'priority',
        'recommendedUse', 'url', 'status', 'notes', 'visibility',
        'updatedBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
      data.typeFocus is string && data.typeFocus.size() <= 200 &&
      data.priority is string && data.priority.size() <= 30 &&
      (data.priority == 'High' || data.priority == 'Optional' || data.priority == 'Reference' || data.priority == 'Parked') &&
      data.recommendedUse is string && data.recommendedUse.size() <= 500 &&
      data.url is string && data.url.size() <= 1000 &&
      data.status is string && data.status.size() <= 40 &&
      (data.status == 'Not started' || data.status == 'In progress' || data.status == 'Completed' || data.status == 'Reference') &&
      data.notes is string && data.notes.size() <= 1000 &&
      data.visibility is string && data.visibility.size() <= 32 && data.visibility == 'workspace' &&
      isValidId(data.updatedBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll([
        'userId', 'checkedRoadmapIds', 'checkedRoutineIds', 'checkedCsFundamentalsIds',
        'aptitudeSessionsDone', 'logicPuzzlesDone', 'mockInterviewsDone', 'contestsAttended',
        'weekdayHours', 'weekendHours', 'sem1ExamDates', 'week1JavaCheckResult', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'checkedRoadmapIds', 'checkedRoutineIds', 'checkedCsFundamentalsIds',
        'aptitudeSessionsDone', 'logicPuzzlesDone', 'mockInterviewsDone', 'contestsAttended',
        'weekdayHours', 'weekendHours', 'sem1ExamDates', 'week1JavaCheckResult', 'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      isBoundedStringArray(data.checkedRoadmapIds, 300) &&
      isBoundedStringArray(data.checkedRoutineIds, 20) &&
      isBoundedStringArray(data.checkedCsFundamentalsIds, 150) &&
      data.aptitudeSessionsDone is int && data.aptitudeSessionsDone >= 0 && data.aptitudeSessionsDone <= 5000 &&
      data.logicPuzzlesDone is int && data.logicPuzzlesDone >= 0 && data.logicPuzzlesDone <= 2000 &&
      data.mockInterviewsDone is int && data.mockInterviewsDone >= 0 && data.mockInterviewsDone <= 500 &&
      data.contestsAttended is int && data.contestsAttended >= 0 && data.contestsAttended <= 1000 &&
      data.weekdayHours is string && data.weekdayHours.size() <= 100 &&
      data.weekendHours is string && data.weekendHours.size() <= 100 &&
      data.sem1ExamDates is string && data.sem1ExamDates.size() <= 200 &&
      data.week1JavaCheckResult is string && data.week1JavaCheckResult.size() <= 300 &&
      data.updatedAt is timestamp;
    }

    function isValidProblemLog(data) {
      return data.keys().hasAll([
        'userId', 'problemId', 'title', 'pattern', 'difficulty', 'url',
        'status', 'usedHint', 'spokenExplanationDone', 'solvedAtMs',
        'nextReviewAtMs', 'reSolvedCount', 'notes', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'problemId', 'title', 'pattern', 'difficulty', 'url',
        'status', 'usedHint', 'spokenExplanationDone', 'solvedAtMs',
        'nextReviewAtMs', 'reSolvedCount', 'notes', 'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      isValidId(data.problemId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
      data.pattern is string && data.pattern.size() >= 1 && data.pattern.size() <= 100 &&
      data.difficulty is string && data.difficulty.size() <= 20 &&
      (data.difficulty == 'Easy' || data.difficulty == 'Medium' || data.difficulty == 'Hard') &&
      data.url is string && data.url.size() <= 500 &&
      data.status is string && data.status.size() <= 20 &&
      (data.status == 'todo' || data.status == 'solved' || data.status == 'mastered') &&
      data.usedHint is bool &&
      data.spokenExplanationDone is bool &&
      data.solvedAtMs is int && data.solvedAtMs >= 0 &&
      data.nextReviewAtMs is int && data.nextReviewAtMs >= 0 &&
      data.reSolvedCount is int && data.reSolvedCount >= 0 && data.reSolvedCount <= 1000 &&
      data.notes is string && data.notes.size() <= 2000 &&
      data.updatedAt is timestamp;
    }

    function isValidPatternNote(data) {
      return data.keys().hasAll([
        'userId', 'patternName', 'problemTitle', 'coreIntuition',
        'complexityAnalysis', 'spokenDurationSec', 'selfRating',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'patternName', 'problemTitle', 'coreIntuition',
        'complexityAnalysis', 'spokenDurationSec', 'selfRating',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.patternName is string && data.patternName.size() >= 1 && data.patternName.size() <= 120 &&
      data.problemTitle is string && data.problemTitle.size() <= 200 &&
      data.coreIntuition is string && data.coreIntuition.size() >= 1 && data.coreIntuition.size() <= 3000 &&
      data.complexityAnalysis is string && data.complexityAnalysis.size() <= 500 &&
      data.spokenDurationSec is int && data.spokenDurationSec >= 0 && data.spokenDurationSec <= 1800 &&
      data.selfRating is int && data.selfRating >= 1 && data.selfRating <= 5 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
        'userId', 'date', 'problemsSolved', 'revisionsCompleted',
        'spokenRecorded', 'roadmapTasksDone', 'aptitudeDone',
        'totalActions', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'date', 'problemsSolved', 'revisionsCompleted',
        'spokenRecorded', 'roadmapTasksDone', 'aptitudeDone',
        'totalActions', 'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.problemsSolved is int && data.problemsSolved >= 0 && data.problemsSolved <= 500 &&
      data.revisionsCompleted is int && data.revisionsCompleted >= 0 && data.revisionsCompleted <= 500 &&
      data.spokenRecorded is int && data.spokenRecorded >= 0 && data.spokenRecorded <= 500 &&
      data.roadmapTasksDone is int && data.roadmapTasksDone >= 0 && data.roadmapTasksDone <= 500 &&
      data.aptitudeDone is int && data.aptitudeDone >= 0 && data.aptitudeDone <= 500 &&
      data.totalActions is int && data.totalActions >= 0 && data.totalActions <= 2500 &&
      data.updatedAt is timestamp;
    }

    // 1. /users/{userId} (Public non-PII profiles + study counters)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && existing().workspaceId == 'faang-hub' && (existing().uid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().role == 'member' && incoming().canEditResources == false) ||
          isAdmin()
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Owner updates study metrics or examLightMode (cannot touch role or canEditResources)
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().canEditResources == existing().canEditResources &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'examLightMode', 'solvedCount', 'masteredCount',
              'spokenCount', 'roadmapDoneCount', 'streakDays', 'updatedAt'
            ])
          ) ||
          // Action 2: Admin updates user permissions, roles, or metrics
          isAdmin()
        );

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();

      // Pillar 6: Split-collection PII isolation
      match /private/{infoId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(infoId) && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(infoId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(infoId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          (
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email'])) ||
            isAdmin()
          ) &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(infoId) && isAdmin();
      }
    }

    // 2. /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        isAdmin();

      allow delete: if isSignedIn() && isValidId(adminId) && isAdmin();
    }

    // 3. /resources/{resourceId}
    match /resources/{resourceId} {
      allow get: if isSignedIn() && isValidId(resourceId);
      allow list: if isSignedIn() && existing().visibility == 'workspace';

      allow create: if isSignedIn() &&
        isValidId(resourceId) &&
        isValidResourceItem(incoming()) &&
        incoming().id == resourceId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canEditResources();

      allow update: if isSignedIn() &&
        isValidId(resourceId) &&
        isValidResourceItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (
          (
            canEditResources() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'typeFocus', 'priority', 'recommendedUse',
              'url', 'status', 'notes', 'updatedBy', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isSignedIn() && isValidId(resourceId) && canEditResources();
    }

    // 4. /userProgress/{userId}
    match /userProgress/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().userId == userId &&
        incoming().updatedAt == request.time &&
        (isOwner(userId) || isAdmin()) &&
        exists(/databases/$(database)/documents/users/$(userId));

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'checkedRoadmapIds', 'checkedRoutineIds', 'checkedCsFundamentalsIds',
              'aptitudeSessionsDone', 'logicPuzzlesDone', 'mockInterviewsDone',
              'contestsAttended', 'weekdayHours', 'weekendHours', 'sem1ExamDates',
              'week1JavaCheckResult', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    // 5. /problemLogs/{logId}
    match /problemLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(logId) &&
        isValidProblemLog(incoming()) &&
        incoming().updatedAt == request.time &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isSignedIn() &&
        isValidId(logId) &&
        isValidProblemLog(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().problemId == existing().problemId &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'pattern', 'difficulty', 'url', 'status', 'usedHint',
              'spokenExplanationDone', 'solvedAtMs', 'nextReviewAtMs',
              'reSolvedCount', 'notes', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 6. /patternNotes/{noteId}
    match /patternNotes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(noteId) &&
        isValidPatternNote(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isSignedIn() &&
        isValidId(noteId) &&
        isValidPatternNote(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'patternName', 'problemTitle', 'coreIntuition',
              'complexityAnalysis', 'spokenDurationSec', 'selfRating', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isSignedIn() && isValidId(noteId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 7. /activityLogs/{activityId}
    match /activityLogs/{activityId} {
      allow get: if isSignedIn() && isValidId(activityId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(activityId) &&
        isValidActivityLog(incoming()) &&
        incoming().updatedAt == request.time &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isSignedIn() &&
        isValidId(activityId) &&
        isValidActivityLog(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().date == existing().date &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'problemsSolved', 'revisionsCompleted', 'spokenRecorded',
              'roadmapTasksDone', 'aptitudeDone', 'totalActions', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isSignedIn() && isValidId(activityId) && isAdmin();
    }
  }
}
